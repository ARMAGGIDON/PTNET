<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] - Лабораторна робота №7</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav>
        <a asp-page="/Index">Завдання 1 (ПІБ)</a>
        <a asp-page="/Registration">Завдання 2 (Реєстрація)</a>
        <form method="post" asp-page="/SessionReset" asp-route-returnUrl="@Context.Request.Path" style="margin: 0 0 0 auto;">
            <button type="submit" formnovalidate class="btn-reset" style="background: #cbd5e1; color: #334155; box-shadow: none; margin: 0; padding: 8px 16px;">
                Скинути сеанс
            </button>
        </form>
    </nav>
</header>
<main>@RenderBody()</main>
</body>
</html>