<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] — Лабораторна робота №7</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f5f6fa; color: #202530; font: 16px/1.5 "Segoe UI", sans-serif; }
        header { background: #fff; border-bottom: 1px solid #d9dee8; }
        nav { display: flex; gap: 24px; max-width: 860px; margin: auto; padding: 16px 20px; }
        a { color: #2059b5; text-decoration: none; }
        a:hover { text-decoration: underline; }
        main { max-width: 860px; margin: 28px auto; padding: 0 20px; }
        section { background: #fff; padding: 28px; border: 1px solid #e0e4ec; border-radius: 12px; }
        h1 { margin-top: 0; font-size: 1.6rem; }
        label { display: block; font-weight: 600; margin: 12px 0 5px; }
        input { display: block; width: 100%; max-width: 440px; padding: 9px 11px; font: inherit;
                border: 1px solid #adb8ca; border-radius: 6px; }
        button { margin-top: 18px; padding: 10px 18px; background: #235fc2; color: #fff; border: 0;
                 border-radius: 6px; cursor: pointer; font: inherit; }
        button:disabled { background: #9299a7; cursor: not-allowed; }
        .message { margin-top: 20px; padding: 13px 16px; background: #f0f5ff; border-radius: 8px; }
        .error { color: #a32121; background: #fff0f0; }
        .success { color: #176638; background: #edf9f0; }
        .column-name { margin: 8px 0; line-height: 1.65; font-weight: 600; }
        .hint { color: #5d6473; font-size: .94rem; }
    </style>
</head>
<body>
<header>
    <nav>
        <a asp-page="/Index">Завдання 1 — обробка ПІБ</a>
        <a asp-page="/Registration">Завдання 2 — реєстрація</a>
    </nav>
</header>
<main>@RenderBody()</main>
</body>
</html>
